# Provision this through the Neon integration in the Vercel Marketplace.
DATABASE_URL=

# Provision this by connecting a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Server-only secrets. Never prefix these names with NEXT_PUBLIC_.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
PUBLIC_FORM_RATE_LIMIT_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
OPENAI_API_KEY=

# Keep disabled after the production data import. Enabling it seeds code defaults
# only when a content table is empty.
BOOTSTRAP_DEFAULT_CONTENT=false
